# Sao chép file này thành .env.local và điền giá trị thật từ Firebase Console
# (Project Settings → General → Your apps → SDK config).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Mặc định dev luôn dùng Firebase Emulator Suite (an toàn, không đụng dữ liệu
# thật). Chỉ set "true" khi THỰC SỰ cần test trực tiếp trên production.
VITE_USE_PRODUCTION_FIREBASE=false
