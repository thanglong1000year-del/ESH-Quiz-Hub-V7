rules_version = '2';

// ESH Quiz Hub V7 — Firestore Rules
//
// Nguyên tắc (xem docs/DATA_MODEL.md):
//   1. Mỗi subject là một không gian dữ liệu cô lập hoàn toàn, gắn với
//      đúng 1 giáo viên sở hữu (ownerTeacherId). Không chia sẻ giữa các môn.
//   2. KHÔNG có fallback theo domain email (bài học từ V6.3.8) — mọi quyền
//      đều tường minh qua role trong /users/{uid} + ownerTeacherId đối chiếu
//      request.auth.uid.
//   3. Owner (vai trò nền tảng) có quyền đọc/ghi toàn bộ để vận hành, hỗ trợ,
//      và chạy quy trình đóng năm học — nhưng mọi hành động của Owner trên
//      dữ liệu môn học cụ thể nên đi qua Cloud Functions có audit log,
//      không thao tác trực tiếp từ client trong production.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Học sinh dùng tài khoản ẩn danh (anonymous auth) để nộp bài — họ KHÔNG
    // có document /users/{uid}. get() trên document không tồn tại sẽ throw,
    // nên phải kiểm tra exists() trước (exists() không bao giờ throw) rồi
    // mới get() — nếu không, mọi `isOwner() || isTeacher()` sẽ throw ngay cả
    // khi đứng bên trái của `||`, làm sập toàn bộ điều kiện allow thay vì
    // rơi xuống nhánh bên phải dành cho học sinh.
    function hasProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isOwner() {
      return signedIn() && hasProfile() && myProfile().data.role == 'owner';
    }

    function isTeacher() {
      return signedIn() && hasProfile() && myProfile().data.role == 'teacher';
    }

    // Cô lập theo môn: chỉ giáo viên sở hữu CHÍNH môn đó (hoặc Owner) được truy cập.
    function ownsSubject(subjectId) {
      return isOwner() ||
        (isTeacher() &&
         get(/databases/$(database)/documents/subjects/$(subjectId)).data.ownerTeacherId == request.auth.uid);
    }

    // --- Nền tảng ---
    match /platformConfig/{doc} {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      // Chỉ Owner tạo/sửa hồ sơ người dùng (tạo tài khoản giáo viên, gán môn)
      // — giữ nguyên nguyên tắc đã chốt: Owner kiểm soát việc tạo giáo viên mới.
      allow write: if isOwner();
    }

    // --- Môn học: gốc của cô lập dữ liệu ---
    match /subjects/{subjectId} {
      allow read: if ownsSubject(subjectId);
      // Chỉ Owner tạo môn học mới (đã chốt trong kế hoạch kiến trúc).
      allow create: if isOwner();
      allow update: if ownsSubject(subjectId);
      allow delete: if isOwner();

      // Ngân hàng câu hỏi — bền vững, chỉ giáo viên sở hữu môn.
      match /questionBank/{questionId} {
        allow read: if ownsSubject(subjectId);
        allow create, update: if ownsSubject(subjectId)
          && request.resource.data.subjectId == subjectId;
        allow delete: if ownsSubject(subjectId);
      }

      // Khung chương trình — bền vững.
      match /curriculum/{nodeId} {
        allow read, write: if ownsSubject(subjectId);
      }

      // Lớp học — theo năm học.
      match /classes/{classId} {
        allow read, write: if ownsSubject(subjectId)
          && request.resource.data.subjectId == subjectId;

        match /students/{studentId} {
          allow read, write: if ownsSubject(subjectId);
        }

        // Bài tập tự luận — chỉ tick nộp/chưa nộp theo tuần, không điểm số
        // hay nhận xét (xem docs/DATA_MODEL.md). Độc lập với assignments/
        // submissions (đề trắc nghiệm) ở trên.
        match /writtenWeeks/{weekId} {
          allow read, write: if ownsSubject(subjectId);
        }

        match /writtenSubmissions/{submissionId} {
          allow read, write: if ownsSubject(subjectId);
        }
      }

      // Đề/bài giao, bài làm, điểm danh — theo năm học.
      match /assignments/{assignmentId} {
        // Giáo viên sở hữu môn: toàn quyền. Học sinh (bất kỳ ai có link, kể
        // cả tài khoản ẩn danh): chỉ đọc khi đề đã "published" — dùng để
        // hiển thị đề bài khi làm bài. KHÔNG được chứa đáp án đúng trong
        // document này (xem `questionsSnapshot` — phải lược bỏ correctOptionIds
        // khi tạo, chấm điểm thật diễn ra server-side qua Cloud Function
        // `submitAssignment`, không qua client write trực tiếp).
        allow read: if ownsSubject(subjectId) ||
          (signedIn() && resource.data.status == 'published');
        allow create, update, delete: if ownsSubject(subjectId);
      }

      match /submissions/{submissionId} {
        // Giáo viên sở hữu môn đọc/ghi mọi bài làm trong môn mình. Học sinh
        // KHÔNG ghi trực tiếp vào đây — nộp bài đi qua Cloud Function
        // `submitAssignment` (Admin SDK, bỏ qua rules) để chấm điểm server-side
        // và tránh lộ đáp án đúng cho client.
        allow read, write: if ownsSubject(subjectId);
      }

      match /attendance/{recordId} {
        allow read, write: if ownsSubject(subjectId);
      }

      // Snapshot lưu trữ khi đóng năm học — chỉ đọc sau khi tạo, Owner xoá khi hết hạn.
      match /archives/{schoolYear} {
        allow read: if ownsSubject(subjectId);
        allow create: if isOwner();
        allow update: if false; // archive là immutable
        allow delete: if isOwner();
      }
    }
  }
}
