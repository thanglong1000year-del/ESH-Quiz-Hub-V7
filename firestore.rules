rules_version = '2';

// ESH Quiz Hub V7 — Firestore Rules
//
// Nguyên tắc (xem docs/DATA_MODEL.md):
//   1. Mỗi subject là một không gian dữ liệu cô lập hoàn toàn. Không chia sẻ
//      giữa các môn.
//   2. Trong 1 môn có 2 vai trò giáo viên (field `teacherRole` ở /users/{uid},
//      KHÔNG còn chỉ dựa vào subjects.ownerTeacherId như bản đầu):
//        - "admin": do Owner tạo (Cloud Function `createTeacherAdmin`) —
//          toàn quyền trong môn, mời thêm viewer.
//        - "viewer": do admin mời (`teacherInvites` + Cloud Function
//          `claimTeacherInvite`) — CHỈ đọc, giới hạn đúng 1 lớp
//          (`viewerClassId`), không bao giờ có quyền ghi.
//   3. KHÔNG có fallback theo domain email (bài học từ V6.3.8) — mọi quyền
//      đều tường minh qua role/teacherRole trong /users/{uid}.
//   4. Owner (vai trò nền tảng) có quyền đọc/ghi toàn bộ để vận hành, hỗ trợ,
//      và chạy quy trình đóng năm học — nhưng mọi hành động của Owner trên
//      dữ liệu môn học cụ thể nên đi qua Cloud Functions có audit log,
//      không thao tác trực tiếp từ client trong production.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Học sinh dùng tài khoản ẩn danh (anonymous auth) để nộp bài — họ KHÔNG
    // có document /users/{uid}. get() trên document không tồn tại sẽ throw,
    // nên phải kiểm tra exists() trước (exists() không bao giờ throw) rồi
    // mới get() — nếu không, mọi `isOwner() || isTeacher()` sẽ throw ngay cả
    // khi đứng bên trái của `||`, làm sập toàn bộ điều kiện allow thay vì
    // rơi xuống nhánh bên phải dành cho học sinh.
    function hasProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isOwner() {
      return signedIn() && hasProfile() && myProfile().data.role == 'owner';
    }

    function isTeacher() {
      return signedIn() && hasProfile() && myProfile().data.role == 'teacher';
    }

    // Giáo viên THUỘC đúng môn này (bất kể admin hay viewer).
    function isSubjectMember(subjectId) {
      return isTeacher() && myProfile().data.subjectId == subjectId;
    }

    // Admin của môn = giáo viên sở hữu (tạo bởi Owner) — toàn quyền trong môn,
    // có thể mời thêm giáo viên viewer. Dựa vào teacherRole trong hồ sơ, KHÔNG
    // còn dựa vào subjects.ownerTeacherId (vẫn giữ field đó để hiển thị/tương
    // thích, nhưng rules không đọc lại subjects nữa — đỡ 1 lượt get()).
    function isSubjectAdmin(subjectId) {
      return isSubjectMember(subjectId) && myProfile().data.teacherRole == 'admin';
    }

    // Viewer của môn — chỉ xem, không ghi; phạm vi xem bị thu hẹp tiếp theo
    // ĐÚNG 1 lớp qua isViewerOfClass().
    function isSubjectViewer(subjectId) {
      return isSubjectMember(subjectId) && myProfile().data.teacherRole == 'viewer';
    }

    function isViewerOfClass(subjectId, classId) {
      return isSubjectViewer(subjectId) && myProfile().data.viewerClassId == classId;
    }

    // Toàn quyền trong môn: Owner hoặc admin của chính môn đó. Viewer KHÔNG
    // được coi là "ownsSubject" — mọi quyền ghi trong môn đều loại viewer ra.
    function ownsSubject(subjectId) {
      return isOwner() || isSubjectAdmin(subjectId);
    }

    // --- Nền tảng ---
    match /platformConfig/{doc} {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      // Hồ sơ giáo viên (cả admin và viewer) CHỈ được tạo qua Cloud Function
      // (Admin SDK, bỏ qua rules): `createTeacherAdmin` (Owner gọi) hoặc
      // `claimTeacherInvite` (viewer tự nhận lời mời khi đăng nhập Google).
      // Client không bao giờ write trực tiếp — chỉ Owner được phép sửa tay
      // khi cần xử lý ngoại lệ. Admin của môn KHÔNG đọc trực tiếp hồ sơ
      // viewer họ mời — tên/trạng thái hiển thị qua chính document
      // `teacherInvites` (có sẵn `email`/`acceptedDisplayName`), tránh phải
      // mở quyền đọc /users/{uid} chéo giữa các giáo viên.
      allow write: if isOwner();
    }

    // --- Môn học: gốc của cô lập dữ liệu ---
    match /subjects/{subjectId} {
      allow read: if ownsSubject(subjectId) || isSubjectViewer(subjectId);
      // Tạo môn học (+ tài khoản admin giáo viên tương ứng) đi qua Cloud
      // Function `createTeacherAdmin` (Admin SDK, bỏ qua rules) — Owner gọi
      // từ UI, không ghi trực tiếp vào đây.
      allow create: if isOwner();
      allow update: if ownsSubject(subjectId);
      allow delete: if isOwner();

      // Ngân hàng câu hỏi — bền vững, chỉ giáo viên sở hữu môn.
      match /questionBank/{questionId} {
        allow read: if ownsSubject(subjectId);
        allow create, update: if ownsSubject(subjectId)
          && request.resource.data.subjectId == subjectId;
        allow delete: if ownsSubject(subjectId);
      }

      // Khung chương trình — bền vững.
      match /curriculum/{nodeId} {
        allow read, write: if ownsSubject(subjectId);
      }

      // Lớp học — theo năm học. Tách riêng allow read khỏi allow create/update
      // (không dùng chung "allow read, write" kèm điều kiện request.resource
      // nữa — request.resource chỉ có ý nghĩa cho ghi, trộn vào rule đọc dễ
      // gây lỗi đánh giá). Viewer chỉ đọc được ĐÚNG lớp họ được gán.
      match /classes/{classId} {
        allow read: if ownsSubject(subjectId) || isViewerOfClass(subjectId, classId);
        allow create, update: if ownsSubject(subjectId)
          && request.resource.data.subjectId == subjectId;
        allow delete: if ownsSubject(subjectId);

        match /students/{studentId} {
          allow read: if ownsSubject(subjectId) || isViewerOfClass(subjectId, classId);
          allow write: if ownsSubject(subjectId);
        }

        // Bài tập tự luận — chỉ tick nộp/chưa nộp theo tuần, không điểm số
        // hay nhận xét (xem docs/DATA_MODEL.md). Độc lập với assignments/
        // submissions (đề trắc nghiệm) ở trên. Viewer chỉ xem.
        match /writtenWeeks/{weekId} {
          allow read: if ownsSubject(subjectId) || isViewerOfClass(subjectId, classId);
          allow write: if ownsSubject(subjectId);
        }

        match /writtenSubmissions/{submissionId} {
          allow read: if ownsSubject(subjectId) || isViewerOfClass(subjectId, classId);
          allow write: if ownsSubject(subjectId);
        }
      }

      // Đề/bài giao, bài làm, điểm danh — theo năm học.
      match /assignments/{assignmentId} {
        // Giáo viên sở hữu môn: toàn quyền. Viewer: chỉ đọc đề của ĐÚNG lớp
        // họ được gán (xem "làm thử không ghi nhận" qua Cloud Function
        // `previewAssignment`, không phải qua write ở đây). Học sinh (bất kỳ
        // ai có link, kể cả tài khoản ẩn danh): chỉ đọc khi đề đã "published"
        // — dùng để hiển thị đề bài khi làm bài. KHÔNG được chứa đáp án đúng
        // trong document này (xem `questionsSnapshot` — phải lược bỏ
        // correctOptionIds khi tạo, chấm điểm thật diễn ra server-side qua
        // Cloud Function `submitAssignment`, không qua client write trực tiếp).
        allow read: if ownsSubject(subjectId) ||
          isViewerOfClass(subjectId, resource.data.classId) ||
          (signedIn() && resource.data.status == 'published');
        allow create, update, delete: if ownsSubject(subjectId);
      }

      match /submissions/{submissionId} {
        // Giáo viên sở hữu môn đọc/ghi mọi bài làm trong môn mình. Viewer chỉ
        // đọc bài làm của ĐÚNG lớp họ được gán (xem tiến độ/kết quả), không
        // ghi. Học sinh KHÔNG ghi trực tiếp vào đây — nộp bài đi qua Cloud
        // Function `submitAssignment` (Admin SDK, bỏ qua rules) để chấm điểm
        // server-side và tránh lộ đáp án đúng cho client.
        allow read: if ownsSubject(subjectId) ||
          isViewerOfClass(subjectId, resource.data.classId);
        allow write: if ownsSubject(subjectId);
      }

      match /attendance/{recordId} {
        allow read, write: if ownsSubject(subjectId);
      }

      // Snapshot lưu trữ khi đóng năm học — chỉ đọc sau khi tạo, Owner xoá khi hết hạn.
      match /archives/{schoolYear} {
        allow read: if ownsSubject(subjectId);
        allow create: if isOwner();
        allow update: if false; // archive là immutable
        allow delete: if isOwner();
      }
    }

    // Lời mời giáo viên xem-lớp (viewer) — top-level (không nằm dưới
    // subjects/{subjectId}) để Cloud Function `claimTeacherInvite` tra được
    // trực tiếp theo email đã xác thực của người vừa đăng nhập Google, không
    // cần biết trước subjectId. Doc id = email chuẩn hoá (xem core.ts).
    //
    // Chỉ admin của môn tạo/xoá được lời mời của CHÍNH môn mình. Chuyển trạng
    // thái "pending" → "accepted" CHỈ do Cloud Function (Admin SDK, bỏ qua
    // rules) thực hiện khi giáo viên được mời đăng nhập — client không bao
    // giờ update trực tiếp.
    match /teacherInvites/{inviteId} {
      allow read: if ownsSubject(resource.data.subjectId);
      allow create: if ownsSubject(request.resource.data.subjectId)
        && request.resource.data.status == 'pending'
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.email == inviteId;
      allow delete: if ownsSubject(resource.data.subjectId);
      allow update: if false;
    }
  }
}
